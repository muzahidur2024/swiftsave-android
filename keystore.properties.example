# Copy to keystore.properties (do not commit) and point to your release keystore.
# Create a keystore: keytool -genkey -v -keystore swift-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias swift
storeFile=swift-release.jks
storePassword=your-store-password
keyAlias=swift
keyPassword=your-key-password
