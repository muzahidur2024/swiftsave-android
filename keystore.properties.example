# Copy to keystore.properties (workspace root or swiftsave-android/).
# Never commit keystore.properties or keystore files to git.
#
# Prefer PKCS12 (.p12) — industry standard. Android Gradle accepts it the same as JKS.
# Path is relative to the Gradle root: d:\swiftsave app

storeFile=swiftsave-android/downme-release.p12
storePassword=YOUR_STORE_PASSWORD
keyAlias=downme
keyPassword=YOUR_KEY_PASSWORD
